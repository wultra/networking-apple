{
  "_purpose": "This file is used as a definition file for the prepare-release script.",
  "_info": "It defines files that contains version number that should be updated during the release preparation.",
  "library": {
    "name": "networking-apple",
    "type": "ios-oss",
    "podspec": "WultraPowerAuthNetworking.podspec"
  },
  "scriptVersion": 2,
  "devVersion": "0.0.1-dev",
  "files": [
    {
      "description": "Cocoapods definition file.",
      "path": "WultraPowerAuthNetworking.podspec",
      "type": "version_replace",
      "match": "\n  s.version             = '%VERSION%'\n",
      "devChange": true
    },
    {
      "description": "Source constants.",
      "path": "Sources/WultraPowerauthNetworking/WPNConstants.swift",
      "type": "version_replace",
      "match": "sdkVersionName = \"%VERSION%\"",
      "devChange": true
    },
    {
      "description": "Xcode framework version.",
      "path": "WultraPowerAuthNetworking.xcodeproj/WultraPowerAuthNetworking_Info.plist",
      "type": "version_replace",
      "match": "  <key>CFBundleShortVersionString</key>\n  <string>%VERSION%</string>",
      "devChange": true
    },
    {
      "description": "Changelog in README.",
      "path": "README.md",
      "type": "tba_replace",
      "match": "### TBA"
    },
    {
      "description": "Verify that the changelog does not contain a TBA placeholder.",
      "path": "README.md",
      "type": "verify_not_containing",
      "match": "- TBA"
    }
  ],
  "scripts": [
    {
      "type": "bash",
      "script": "pod lib lint --allow-warnings",
      "description": "run pod lint"
    }
  ]
}